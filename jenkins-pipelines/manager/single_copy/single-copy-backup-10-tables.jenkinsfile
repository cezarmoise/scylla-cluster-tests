#!groovy

// trick from https://github.com/jenkinsci/workflow-cps-global-lib-plugin/pull/43
def lib = library identifier: 'sct@snapshot', retriever: legacySCM(scm)

managerPipeline(
    backend: 'aws',
    region: 'us-east-1',
    scylla_version: 'master:latest',
    billing_project: 'Single-copy backup',
    test_name: 'single_copy_test.SingleCopyTest.test_backup_half_repaired',
    test_config: '''["test-cases/manager/single_copy/backup.yaml", "configurations/object_storage_s3.yaml"]''',
    // 200GB dataset per rack in 10 tables
    extra_environment_variables: '''SCT_USER_PROFILE_TABLE_COUNT=10
SCT_MGMT_PREPARE_SNAPSHOT_SIZE=200''',
)
